{
  "id": "discovery-trust-valid-001",
  "description": "Configured trusted key + active + origin match = authenticated",
  "category_hint": "discovery",
  "input": {
    "trust": {
      "configuredTrustedThumbprints": ["abc123def456"],
      "actualSigningThumbprint": "abc123def456",
      "profileOrigin": "https://provider.example",
